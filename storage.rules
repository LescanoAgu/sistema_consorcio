rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Permite acceso a la carpeta "consorcios" a miembros o administradores del consorcio
    match /consorcios/{consortiumId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/consortiums/$(consortiumId)).data.adminIds.hasAny([request.auth.uid]) ||
        firestore.exists(/databases/(default)/documents/user_access/$(request.auth.token.email.lower())/consortium_roles/$(consortiumId)) ||
        firestore.exists(/databases/(default)/documents/user_access/$(request.auth.token.email)/consortium_roles/$(consortiumId)) ||
        (firestore.exists(/databases/(default)/documents/user_access/$(request.auth.token.email.lower())) && 
         consortiumId in firestore.get(/databases/(default)/documents/user_access/$(request.auth.token.email.lower())).data.consortiumIds) ||
        (firestore.exists(/databases/(default)/documents/user_access/$(request.auth.token.email)) && 
         consortiumId in firestore.get(/databases/(default)/documents/user_access/$(request.auth.token.email)).data.consortiumIds)
      );
    }

    // Comprobantes de pago informados por vecinos o admin: máximo 10 MB, solo imágenes o PDF
    match /receipts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Documentos, comprobantes de gastos y logos institucionales (con tope de tamaño)
    match /documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }
    match /expenses/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }
    match /logos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
