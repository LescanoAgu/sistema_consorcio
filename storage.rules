rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Permite acceso a la carpeta "consorcios" a miembros o administradores del consorcio
    match /consorcios/{consortiumId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/consortiums/$(consortiumId)).data.adminIds.hasAny([request.auth.uid]) ||
        firestore.exists(/databases/(default)/documents/user_access/$(request.auth.token.email)/consortium_roles/$(consortiumId)) ||
        (firestore.exists(/databases/(default)/documents/user_access/$(request.auth.token.email)) && 
         consortiumId in firestore.get(/databases/(default)/documents/user_access/$(request.auth.token.email)).data.consortiumIds)
      );
    }

    // Rutas directas de documentos, comprobantes de gastos, recibos de pago y logos
    match /documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /expenses/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /logos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}