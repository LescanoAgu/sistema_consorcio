rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---

    // 1. ¿Es Admin de ESTE consorcio?
    function isAdmin(consortiumId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/consortiums/$(consortiumId)).data.adminIds;
    }
    
    // 2. ¿Es un usuario/vecino autorizado en este consorcio? (Soporta email exacto y minúsculas)
    function isAuthorizedUser(consortiumId) {
      return request.auth != null && request.auth.token.email != null && (
        exists(/databases/$(database)/documents/user_access/$(request.auth.token.email.lower())/consortium_roles/$(consortiumId)) ||
        exists(/databases/$(database)/documents/user_access/$(request.auth.token.email)/consortium_roles/$(consortiumId)) ||
        (exists(/databases/$(database)/documents/user_access/$(request.auth.token.email.lower())) &&
         consortiumId in get(/databases/$(database)/documents/user_access/$(request.auth.token.email.lower())).data.consortiumIds) ||
        (exists(/databases/$(database)/documents/user_access/$(request.auth.token.email)) &&
         consortiumId in get(/databases/$(database)/documents/user_access/$(request.auth.token.email)).data.consortiumIds)
      );
    }

    // 2b. ¿Pertenece el usuario autenticado a la unidad indicada?
    function isUnitMember(consortiumId, unitId) {
      let unitEmails = get(/databases/$(database)/documents/consortiums/$(consortiumId)/units/$(unitId)).data.authorizedEmails;
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email.lower() in unitEmails ||
        request.auth.token.email in unitEmails
      );
    }
    
    // 3. ¿Tiene permiso para crear más consorcios? (Control SaaS)
    function canCreateConsortium() {
      return !exists(/databases/$(database)/documents/saas_admins/$(request.auth.uid)) || (
        get(/databases/$(database)/documents/saas_admins/$(request.auth.uid)).data.activeConsortiums < get(/databases/$(database)/documents/saas_admins/$(request.auth.uid)).data.maxConsortiums
      );
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Colección de Control SaaS (Solo legible por el dueño del plan)
    match /saas_admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // Solicitudes de Ingreso (Join Requests) globales
    match /join_requests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.status == 'PENDING'
                    && (request.resource.data.userEmail == request.auth.token.email || request.resource.data.userEmail == request.auth.token.email.lower());
      allow read: if request.auth != null && (
                    request.auth.token.email == resource.data.userEmail ||
                    request.auth.token.email.lower() == resource.data.userEmail ||
                    isAdmin(resource.data.consortiumId)
                  );
      allow update, delete: if request.auth != null && isAdmin(resource.data.consortiumId);
    }

    // 2. Perfiles de usuario (Accesos rápidos)
    match /user_access/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || request.auth.token.email.lower() == email);
      allow write: if false; // Solo se escribe por Cloud Functions o usando la subcolección
      
      // Subcolección segura para roles de consorcio
      match /consortium_roles/{consortiumId} {
          allow read: if request.auth != null && (request.auth.token.email == email || request.auth.token.email.lower() == email);
          allow write: if isAdmin(consortiumId);
      }
    }

    // 3. Consorcios
    match /consortiums/{consortiumId} {
      // Crear: Si está autenticado y respeta su cupo SaaS
      allow create: if request.auth != null && canCreateConsortium();
      
      // LEER: Usuarios autenticados pueden ver el listado básico de consorcios para solicitar unirse,
      // mientras que todas las subcolecciones internas exigen ser miembro o administrador.
      allow read: if request.auth != null;

      // Modificar/Borrar: Solo Admins de ese consorcio
      allow update, delete: if isAdmin(consortiumId);
      
      // --- SUBCOLECCIONES ---
      
      // A. Unidades (Cada vecino solo puede leer su(s) propia(s) unidad(es))
      match /units/{unitId} {
        allow read: if isAdmin(consortiumId) || (
          request.auth != null && request.auth.token.email != null && (
            request.auth.token.email.lower() in resource.data.authorizedEmails ||
            request.auth.token.email in resource.data.authorizedEmails
          )
        );
        allow write: if isAdmin(consortiumId);
      }

      // B. Gastos, Liquidaciones
      match /expenses/{expenseId} {
        allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
        allow write: if isAdmin(consortiumId);
      }
      
      match /settlements/{settlementId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }
      
      // C. Pagos (Vecinos solo pueden crear pagos en estado PENDING para sus unidades y leer los suyos)
      match /payments/{paymentId} {
        allow create: if request.auth != null && (
          isAdmin(consortiumId) || (
            request.resource.data.status == 'PENDING' &&
            request.resource.data.amount > 0 &&
            isUnitMember(consortiumId, request.resource.data.unitId)
          )
        );
        allow read: if isAdmin(consortiumId) || (resource.data != null && isUnitMember(consortiumId, resource.data.unitId));
        allow update, delete: if isAdmin(consortiumId);
      }
      
      // D. Historial (History)
      match /history/{historyId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // E. Ajustes (Settings)
      match /settings/{settingId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // F. Anuncios (Announcements)
      match /announcements/{announcementId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // G. Mantenimiento (Vecinos solo crean y ven reclamos de sus unidades; Admin gestiona estados/respuestas)
      match /maintenance/{reqId} {
         allow read: if isAdmin(consortiumId) || (resource.data != null && isUnitMember(consortiumId, resource.data.unitId));
         allow create: if isAdmin(consortiumId) || (
           isAuthorizedUser(consortiumId) &&
           request.resource.data.status == 'PENDING' &&
           isUnitMember(consortiumId, request.resource.data.unitId)
         );
         allow update, delete: if isAdmin(consortiumId);
      }

      // H. Amenities y Bookings
      match /amenities/{amenityId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }
      match /bookings/{bookingId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow create: if isAdmin(consortiumId) || (isAuthorizedUser(consortiumId) && isUnitMember(consortiumId, request.resource.data.unitId));
         allow update, delete: if isAdmin(consortiumId) || (isAuthorizedUser(consortiumId) && isUnitMember(consortiumId, resource.data.unitId));
      }

      // I. Documentos (Documents)
      match /documents/{documentId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // J. Transacciones de Reserva (Reserve Transactions)
      match /reserve_transactions/{txId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // K. Plantillas de Gastos (Expense Templates)
      match /expense_templates/{templateId} {
         allow read: if isAdmin(consortiumId);
         allow write: if isAdmin(consortiumId);
      }
    }
  }
}
