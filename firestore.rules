rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---

    // 1. ¿Es Admin de ESTE consorcio?
    function isAdmin(consortiumId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/consortiums/$(consortiumId)).data.adminIds;
    }
    
    // 2. ¿Es un usuario/vecino autorizado en este consorcio?
    function isAuthorizedUser(consortiumId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_access/$(request.auth.token.email)) &&
        consortiumId in get(/databases/$(database)/documents/user_access/$(request.auth.token.email)).data.consortiumIds;
    }
    
    // 3. ¿Tiene permiso para crear más consorcios? (Control SaaS)
    function canCreateConsortium() {
      let adminDoc = get(/databases/$(database)/documents/saas_admins/$(request.auth.uid));
      return adminDoc != null && adminDoc.data.activeConsortiums < adminDoc.data.maxConsortiums;
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Colección de Control SaaS (Solo legible por el dueño del plan)
    match /saas_admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // Solicitudes de Ingreso (Join Requests) globales
    match /join_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.userEmail == request.auth.token.email;
      allow read: if request.auth != null && (request.auth.token.email == resource.data.userEmail || isAdmin(resource.data.consortiumId));
      allow update, delete: if request.auth != null && isAdmin(resource.data.consortiumId);
    }

    // 2. Perfiles de usuario (Accesos rápidos)
    match /user_access/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false; // Solo se puede escribir por Cloud Functions o usando la subcolección
      
      // Subcolección segura para roles de consorcio
      match /consortium_roles/{consortiumId} {
          allow read: if request.auth != null && request.auth.token.email == email;
          allow write: if isAdmin(consortiumId);
      }
    }

    // 3. Consorcios
    match /consortiums/{consortiumId} {
      // Crear: Solo si tiene plan SaaS activo
      allow create: if request.auth != null && canCreateConsortium();
      
      // LEER: CORREGIDO. Solo ve el consorcio si es Admin del mismo O si es un vecino asignado.
      allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);

      // Modificar/Borrar: Solo Admins de ese consorcio
      allow update, delete: if isAdmin(consortiumId);
      
      // --- SUBCOLECCIONES ---
      
      // A. Unidades
      match /units/{unitId} {
        allow read: if isAdmin(consortiumId) || (request.auth.token.email in resource.data.authorizedEmails);
        allow write: if isAdmin(consortiumId);
      }

      // B. Gastos, Liquidaciones
      match /expenses/{expenseId} {
        allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
        allow write: if isAdmin(consortiumId);
      }
      
      match /settlements/{settlementId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }
      
      // C. Pagos
      match /payments/{paymentId} {
        allow create: if request.auth != null && (isAdmin(consortiumId) || request.auth.token.email in get(/databases/$(database)/documents/consortiums/$(consortiumId)/units/$(request.resource.data.unitId)).data.authorizedEmails);
        allow read: if isAdmin(consortiumId) || (resource.data != null && request.auth.token.email in get(/databases/$(database)/documents/consortiums/$(consortiumId)/units/$(resource.data.unitId)).data.authorizedEmails);
        allow update, delete: if isAdmin(consortiumId);
      }
      
      // D. Historial (History)
      match /history/{historyId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // E. Ajustes (Settings)
      match /settings/{settingId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // F. Anuncios (Announcements)
      match /announcements/{announcementId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // G. Mantenimiento (Maintenance)
      match /maintenance/{reqId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId) || (resource.data != null && request.auth.token.email in get(/databases/$(database)/documents/consortiums/$(consortiumId)/units/$(resource.data.unitId)).data.authorizedEmails);
         allow create: if isAuthorizedUser(consortiumId);
      }

      // H. Amenities y Bookings
      match /amenities/{amenityId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }
      match /bookings/{bookingId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow create: if isAdmin(consortiumId) || (isAuthorizedUser(consortiumId) && request.auth.token.email in get(/databases/$(database)/documents/consortiums/$(consortiumId)/units/$(request.resource.data.unitId)).data.authorizedEmails);
         allow update, delete: if isAdmin(consortiumId) || (isAuthorizedUser(consortiumId) && request.auth.token.email in get(/databases/$(database)/documents/consortiums/$(consortiumId)/units/$(resource.data.unitId)).data.authorizedEmails);
      }

      // I. Documentos (Documents)
      match /documents/{documentId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // J. Transacciones de Reserva (Reserve Transactions)
      match /reserve_transactions/{txId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }

      // K. Plantillas de Gastos (Expense Templates)
      match /expense_templates/{templateId} {
         allow read: if isAdmin(consortiumId);
         allow write: if isAdmin(consortiumId);
      }
    }
  }
}