rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---

    // 1. ¿Es Admin de ESTE consorcio?
    function isAdmin(consortiumId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/consortiums/$(consortiumId)).data.adminIds;
    }
    
    // 2. ¿Es un usuario/vecino autorizado en este consorcio?
    function isAuthorizedUser(consortiumId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_access/$(request.auth.token.email)) &&
        consortiumId in get(/databases/$(database)/documents/user_access/$(request.auth.token.email)).data.consortiumIds;
    }
    
    // 3. ¿Tiene permiso para crear más consorcios? (Control SaaS)
    function canCreateConsortium() {
      let adminDoc = get(/databases/$(database)/documents/saas_admins/$(request.auth.uid));
      return adminDoc != null && adminDoc.data.activeConsortiums < adminDoc.data.maxConsortiums;
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Colección de Control SaaS (Solo legible por el dueño del plan)
    match /saas_admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // 2. Perfiles de usuario (Accesos rápidos)
    match /user_access/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if request.auth != null;
    }

    // 3. Consorcios
    match /consortiums/{consortiumId} {
      // Crear: Solo si tiene plan SaaS activo
      allow create: if request.auth != null && canCreateConsortium();
      
      // LEER: CORREGIDO. Solo ve el consorcio si es Admin del mismo O si es un vecino asignado.
      allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);

      // Modificar/Borrar: Solo Admins de ese consorcio
      allow update, delete: if isAdmin(consortiumId);
      
      // --- SUBCOLECCIONES ---
      
      // A. Unidades
      match /units/{unitId} {
        allow read: if isAdmin(consortiumId) || (request.auth.token.email in resource.data.authorizedEmails);
        allow write: if isAdmin(consortiumId);
      }

      // B. Gastos, Liquidaciones
      match /expenses/{expenseId} {
        allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
        allow write: if isAdmin(consortiumId);
      }
      
      match /settlements/{settlementId} {
         allow read: if isAdmin(consortiumId) || isAuthorizedUser(consortiumId);
         allow write: if isAdmin(consortiumId);
      }
      
      // C. Pagos
      match /payments/{paymentId} {
        allow create: if request.auth != null;
        allow read: if isAdmin(consortiumId) || (resource.data != null && request.auth.token.email in get(/databases/$(database)/documents/consortiums/$(consortiumId)/units/$(resource.data.unitId)).data.authorizedEmails);
        allow update, delete: if isAdmin(consortiumId);
      }
    }
  }
}